[Unit]
Description=Sway Window Manager (VLS Session)
Documentation=man:sway(5)
BindsTo=vls-session.target
PartOf=vls-session.target
Before=vls-session.target

[Service]
Type=simple
EnvironmentFile=-/etc/sway/env
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=sway
Environment=XDG_SESSION_DESKTOP=sway
ExecStart=sway
ExecStartPost=/bin/sh -c 'sleep 0.5; systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK'
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=vls-session.target