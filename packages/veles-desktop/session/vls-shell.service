[Unit]
Description=VLS Shell (Wayland Desktop Shell)
BindsTo=vls-session.target
PartOf=vls-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/quickshell -p /usr/share/vls-shell
ExecStartPost=/bin/sh -c 'echo $MAINPID > %t/vls-shell.pid'
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=vls-session.target